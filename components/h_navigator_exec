#h navigator script for blackbox-hwm, Script version 17.0

# CHANGELOG NOTABLES
#
# Version 5.0.0 marked the introduction of "Gobble Chain" blockchain support for ssl entropy pooling
    # enabled /tex for tmp extended support
    # marked introduction of pulse monitor with killswitch
    # marked introduction of dsigned sha-256 package signing
    # marked introduction of the h navigator profile interpreter, with legacy 'du' fallback  < new dep 'dust' to exec 'foldersize'
    # improved graceful termination, with ctrl+c safety net
# Version 4.6.0 marked the introduction of font cache startup changes
# Version 4.5.0 marked transition from /dev/null > ~/null (nullfsvsf)  < new dep
# Version 4.4.0 marked transition from bash > hash install script
# Version 4.1.0 marked the introduction of h-swap dir in /tmp
# Version 4.0.0 marked a transition from pre-built packages to H-Linux compiled packages, as h-navigator
# Version 3.11.0 marked a transition from Brave base > Origin base. Nightly channel remains unchanged

# Capture script PID for the C daemon to use as the Process Group ID
PGID=$$

# Clean exit trap for normal shutdowns and CTRL+C (SIGINT/SIGTERM)
cleanup() {
    printf '\033[0m\n'
    echo "[*] Terminating H Navigator runtime gracefully..."

    # 1. Stop the heartbeat monitors
    kill $PULSE_PID 2>/dev/null
    kill $KILL_PULSE_PID 2>/dev/null
    rm -f /tmp/h_navigator_pulse 2>/dev/null

    # 2. Terminate Brave and SEXTANT if they are still running
    pkill -TERM -f brave-browser-nightly 2>/dev/null
    pkill -TERM -f sextant.sh 2>/dev/null

    # 3. Securely shred the Gobble Chain session keys
    shred -u /tmp/1V/sys/ctrl/strgctrl0/strgpri0/vfunit0-drive_C/h_navigator_auth_tmp* 2>/dev/null || true
    echo "[+] Session keys shredded."

    # 4. Standard lock and swap cleanup
    rm -fr "$HOME/.config/BraveSoftware/Brave-Browser/Singleton*"
    rm -fr /tmp/h-swap 2>/dev/null

    echo "[*] Teardown complete. Exiting."
    exit 0
}
# Bind the trap to EXIT (normal completion), INT (Ctrl+C), and TERM (kill commands)
trap cleanup EXIT INT TERM

# Create h-swap dir | Create disk null file
mkdir -p /tmp/h-swap
touch $HOME/null/h-navigator.output

echo
echo "Loading h navigator"
echo

viu --height 14 --width 26 "$HOME/Pictures/h-navigator-logo.png"
echo ""

printf '\033[1;31m'
figlet -f banner "H Navigator"

printf '\033[0m'
echo "With AI, Search Bridge and SEXTANT."
echo "⛓️ Secured by Gobble Chain v2 Cryptographic Entropy."
echo
$HOME/.hwm/scripts/h_navigator_version_patch --version
echo "Version 5.0.0-10, built on Brave Origin (nightly). 🔥 [Patched with Singleton Jailbreak]"
echo
echo "Loaded."
echo "running"
echo

mkdir -p /tmp/h-swap
cp -f $HOME/Pictures/w3c.png /tmp/h-swap
zenity --notification --text="H Navigator\nWith AI, Search Bridge and SEXTANT." --timeout=5 --icon='/tmp/h-swap/w3c.png' &>/dev/null

#defs
ENTROPY_POOL="$HOME/Desktop/gobble-chain/gobble_chain_v2"
AUTH_DIR="/tmp/1V/sys/ctrl/strgctrl0/strgpri0/vfunit0-drive_C"

# Silent orphan cleanup before new injection
rm -f $AUTH_DIR/h_navigator_auth_tmp_*  #cont
echo "Generating unique session keys from blockchain entropy pool..."

for key in a b c d; do
    printf '\033[1;33m'
    echo -n "   ➔ Injecting entropy for key $key... "
    sleep 0.2

    KEY_FILE="$AUTH_DIR/h_navigator_auth_tmp_$key"

    # Attempt blockchain entropy pool first
    if [ -f "$ENTROPY_POOL" ] && \
       openssl rand -rand "$ENTROPY_POOL" -base64 48 > "$KEY_FILE" 2>/dev/null; then

        printf '\033[1;32m'
        echo "✔️  DONE"

    else
        # Fallback-mode if blockchain entropy pool unavailable or unusable
            # Remove any partial/failed key prior to fallback
        rm -f "$KEY_FILE"

        printf '\033[1;33m'
        echo
        echo "   ⚠️  Blockchain entropy pool unavailable."
        echo -n "   ↪ Initiating fallback-mode..."

        # Fallback-mode > OpenSSL default CSPRNG entropy pool
        if openssl rand -base64 48 > "$KEY_FILE" 2>/dev/null; then
            printf '\033[1;32m'
            echo "   ✔️  FALLBACK-MODE DONE"
        else
            printf '\033[1;31m'
            echo "   ✖ ERROR — entropy generation failed."
            echo "   H Navigator cannot continue securely. Aborting."
            printf '\033[0m'

            # Securely remove all generated session keys
            shred -u "$AUTH_DIR"/h_navigator_auth_tmp_* 2>/dev/null || true

            exit 1
        fi
    fi
done

printf '\033[0m'
echo "🔒 All session keys secured."
echo

# And now the opening Jailbreak
PROFILE_DIR="$HOME/.config/BraveSoftware/Brave-Browser"

# Only remove stale locks if no Brave process exists
if ! pgrep -f brave-browser-nightly >/dev/null; then
  rm -fr "$PROFILE_DIR"/Singleton*
fi

# Pre-exec font cache alignment. Just keep silent and suppress output
fc-cache 2>/dev/null


# Launch monitors before browser
# 1. Start the kill_pulse monitor with PGID
/usr/bin/pulse $PGID &
KILL_PULSE_PID=$!

sleep 0.5

# 2. Start pulse emitter
(
    while true; do
        # Only pulse if the FIFO pipe still exists
        if [ -p /tmp/h_navigator_pulse ]; then
            echo "1" > /tmp/h_navigator_pulse
        else
            break
        fi
        sleep 2
    done
) &
PULSE_PID=$!

h-navigator --user-data-dir="$HOME/.config/BraveSoftware/Brave-Browser" --proxy-server="192.168.1.69:800" &>~/null/h-navigator.output &
LAUNCHER_PID=$!

# Wait loop
for _ in $(seq 1 100); do
  xdotool search --class "Brave-browser-nightly" >/dev/null 2>&1 && break
  sleep 0.2
done

# Fail fast if no Brave window appears (and shred temp auth)
if ! xdotool search --class "Brave-browser-nightly" >/dev/null 2>&1; then
  echo "H Navigator launch failed: no Brave window detected."
  shred -u /tmp/1V/sys/ctrl/strgctrl0/strgpri0/vfunit0-drive_C/h_navigator_auth_tmp* 2>/dev/null || true
  exit 1
fi

# Wait for Brave to fully fork its master process
sleep 2

# Find the real Brave master — the binary with no --type= flag
BRAVE_PID=$(pgrep -f "/opt/hlinux/brave-nightly/brave" | while read -r pid; do
  cmdline=$(tr '\0' ' ' < /proc/$pid/cmdline 2>/dev/null)
  if [[ "$cmdline" != *"--type="* ]]; then
    echo "$pid"
    break
  fi
done)

# Fallback: lowest PID of the real binary (not the bash wrapper)
if [[ -z "$BRAVE_PID" ]]; then
  BRAVE_PID=$(pgrep -f "/opt/hlinux/brave-nightly/brave" | sort -n | head -1)
fi

echo "Monitoring H Navigator PID: $BRAVE_PID"

# Launch Sextant core monitor in a new terminal window
SEXTANT_PATH="$(realpath "$(dirname "$0")/sextant.sh")"
if [[ -x "$SEXTANT_PATH" ]]; then
  if command -v cherry-terminal &>~/null/h-navigator.output; then
    cherry-terminal --title "⚓ SEXTANT — Core monitor for H Navigator | Blackbox-hwm" -e bash "$SEXTANT_PATH" --monitor "$BRAVE_PID" 1 "H Navigator" &>~/null/h-navigator.output &
  elif command -v xterm &>/dev/null; then
    xterm -e bash "$SEXTANT_PATH" --monitor "$BRAVE_PID" 1 "H Navigator" &>/dev/null &
  elif command -v gnome-terminal &>/dev/null; then
    gnome-terminal -- bash "$SEXTANT_PATH" --monitor "$BRAVE_PID" 1 "H Navigator" &>/dev/null &
  else
    echo "SEXTANT: no supported terminal found (cherry-terminal, xterm, gnome-terminal) — skipping monitor."
  fi
else
  echo "SEXTANT: sextant.sh not found or not executable at $SEXTANT_PATH — skipping monitor."
fi

# Keep enforcing the title using the PID we already found
( while [ -n "$BRAVE_PID" ] && ps -p "$BRAVE_PID" > /dev/null; do
    # Search for all windows belonging to the master Brave PID
    WIDS=$(xdotool search --pid "$BRAVE_PID" 2>/dev/null)
    for WID in $WIDS; do
	xdotool set_window --name "H Navigator. Version 5.0.0-10, built on Brave Origin (nightly). [Patched with Singleton Jailbreak]" "$WID"
    done
    sleep 2
  done ) &

echo

echo "H Navigator is running."

# Verbose output can follow, likely limited
echo ""
echo "------------------------------------------------------------"
echo "                  Warnings and Errors Log!                  "
echo ""
echo "Note:  The 'BadWindow' output is the backend detection      "
echo "       service doing its job. Not an error!                 "
echo "------------------------------------------------------------"
echo ""

# This will set printed output at dark gray
printf '\033[90m'

# Wait for the main Brave launcher process to exit
wait "$LAUNCHER_PID" 2>/dev/null || true

# Extra safety: wait for any remaining Brave processes
while pgrep -f brave >/dev/null; do
  sleep 0.5
done

# And now the closing Jailbreak
rm -fr "$PROFILE_DIR"/Singleton*

sleep 2

# Clean up h-swap dir
rm -fr /tmp/h-swap

echo

# Reset text color to default
printf '\033[0m'
echo -n "Press Return to exit session securely... "
read -r _

# Normal exit triggers the 'cleanup' trap automatically
exit 0
