#!/bin/hash
source /usr/local/lib/h-linux-env.hash

# Cracker Guardian — Instant Singleton* cracker using inotify

PROFILE_DIR="$HOME/.config/BraveSoftware/Brave-Browser"
LOCK_DIR="/tex/h-swap/cracker_guardian.lock.d"

# Atomic lock — create exclusively, fail if exists
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    # Lock exists — check if stale
    OLD_PID=$(cat "$LOCK_DIR/pid" 2>/dev/null)
    if [[ -n "$OLD_PID" ]] && kill -0 "$OLD_PID" 2>/dev/null; then
        echo "[!] Cracker Guardian already running (PID: $OLD_PID)"
        exit 1
    else
        # Stale lock — remove and retry
        rm -rf "$LOCK_DIR"
        mkdir "$LOCK_DIR" 2>/dev/null || { echo "[!] Failed to create lock"; exit 1; }
    fi
fi

# Write our PID
echo $$ > "$LOCK_DIR/pid"

# Cleanup lock on exit
trap 'rm -rf "$LOCK_DIR"; exit 0' EXIT INT TERM

# Verify profile dir exists
if [[ ! -d "$PROFILE_DIR" ]]; then
    echo "[!] Profile directory not found: $PROFILE_DIR"
    exit 1
fi

# Verify inotify-tools
if ! command -v inotifywait >/dev/null 2>&1; then
    echo "[!] inotifywait not found. Run: boxforge install inotify-tools"
    exit 1
fi

echo "[*] 😈 Cracker Guardian active (PID: $$)"

# Initial sweep — catch anything created before we started
rm -f "$PROFILE_DIR"/Singleton* 2>/dev/null

# Event-driven watch loop
while true; do
    # -m: monitor continuously
    # -e create: file creation
    # -e moved_to: file moved into directory (Annoyingly, Brave sometimes does this)
    # --format '%w%f': output full path
    inotifywait -m -e create -e moved_to --format '%w%f' "$PROFILE_DIR" 2>/dev/null | \
    while IFS= read -r FILE; do
        BASENAME=$(basename "$FILE")
        case "$BASENAME" in
            Singleton*)
                # Instant removal
                rm -f "$FILE" 2>/dev/null
                if [[ $? -eq 0 ]]; then
                    echo "[+] Removed: $BASENAME"
                    # Notify of successful rm
                    notify-send --urgency=critical "Cracker Guardian" "Removed: $BASENAME"
                fi
                ;;
        esac
    done
    
    # If inotifywait unexpectedly exits, just pause then restart
    sleep 0.1
done
